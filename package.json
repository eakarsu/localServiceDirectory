{
  "name": "local-service-directory",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/**/*.test.ts",
    "test:unit": "tsx --test tests/unit/**/*.test.ts",
    "test:integration": "tsx --test tests/integration/**/*.test.ts",
    "test:e2e": "RUN_DB_TESTS=1 tsx --test tests/integration/database.test.ts",
    "verify": "npm run db:validate && npm run lint && npm run typecheck && npm test && npm run build",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "demo-data:load": "npx tsx prisma/seed.ts",
    "create-admin": "tsx scripts/create-admin.ts",
    "db:studio": "prisma studio",
    "setup:development": "npm run db:generate && npm run db:migrate:dev"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "date-fns": "^4.1.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^0.555.0",
    "next": "16.2.11",
    "next-auth": "4.24.15",
    "prisma": "^5.22.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hook-form": "^7.67.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.2",
    "eslint-config-next": "16.2.11",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.6",
    "typescript": "^5"
  },
  "overrides": {
    "uuid": "11.1.1",
    "dompurify": "3.4.12",
    "preact": "10.29.7",
    "postcss": "8.5.20",
    "diff": "4.0.4",
    "picomatch": "4.0.4",
    "brace-expansion@<1.1.13": "1.1.13",
    "brace-expansion@>=2.0.0 <2.0.3": "2.0.3",
    "minimatch@<3.1.4": "3.1.4",
    "minimatch@>=9.0.0 <9.0.7": "9.0.7",
    "sharp": "0.35.3"
  },
  "prisma": {
    "seed": "npm run demo-data:load"
  }
}
