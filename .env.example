DATABASE_URL=postgresql://app:change-me@localhost:5432/local_service_directory?schema=public
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-at-least-32-random-characters
INTERNAL_JOB_SECRET=replace-with-an-independent-random-secret

